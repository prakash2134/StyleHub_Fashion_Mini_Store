# ---- Copy this file to ".env" and fill in the values ----

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=sqlite:///./stylehub.db

# Stripe TEST mode keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
# Optional locally. From `stripe listen --forward-to localhost:8000/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=

# Admin account, created automatically on startup. Choose your own password.
ADMIN_EMAIL=admin@stylehub.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Store Admin

# Three-letter ISO code (lowercase). Prices in the seed data are stored in minor units.
CURRENCY=inr

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
